# Settings of the app on the server. Copy to deploy/app.env and fill in.
# deploy/app.env is never committed (.gitignore): it holds secrets.

# Signs the login cookie. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later logs everyone out.
SECRET_KEY=replace-me-with-at-least-32-random-characters

# The address customers type, with https://
SITE_URL=https://stilsmith.example

# By invitation: only people who know this code can create an account. Keep it set until the
# product data is licensed (PRODUCTION.md, "Before customers"). At least 8 characters; make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(9))"
# The link to hand out is  https://stilsmith.example/signup?code=<the code>
# (Delete the line to let anybody create an account. The app does not start on the placeholder.)
INVITE_CODE=replace-me-with-a-code-of-your-own

# A private trial: every page, the landing page too, first asks for this password (the browser's own sign-in
# box; any user name). Use it while the site is not ready for the public (no Impressum address yet, no licensed
# product data): then nothing of it is public. At least 12 characters; make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(12))"
# (Leave the line out to open the site. The app does not start on the placeholder.)
#SITE_PASSWORD=replace-me-with-a-password-of-your-own

# Behind Cloudflare Access (deploy/README.md, step 4): Cloudflare has then checked every visitor's email address
# with a code before a page opens. With both of these set, such a visitor creates his account with one button and
# needs no password, and Cloudflare's check opens his account from then on. Accounts with a password are not
# touched. Neither value is a secret.
#   ACCESS_TEAM   the first part of <name>.cloudflareaccess.com, the address of Cloudflare's login page for your site
#   ACCESS_AUD    the application's "Application Audience (AUD) Tag": Zero Trust > Access controls > Applications,
#                 Edit the application, under Additional settings
# Set both or neither. Leave them out wherever Cloudflare Access is not in front: no token is read then.
#ACCESS_TEAM=my-team
#ACCESS_AUD=

# Outgoing email for password resets. Without it, resets cannot be sent.
#SMTP_URL=smtp://user:password@smtp.example.com:587
#MAIL_FROM=Stilsmith <no-reply@stilsmith.example>

# AI pictures of outfits: Google draws them ([service] in config/looks.toml), so this key switches them on.
# Every picture is billed to it. (OPENAI_API_KEY counts only where that file says use = "openai".)
#GEMINI_API_KEY=
# GEMINI_API_KEY also switches on the style chat on Profile (about a tenth of a cent per message,
# limits in config/style.toml), unless on = false under [chat] there. Without it the chat is not shown.
