# Settings of the app on the server. Copy to deploy/app.env and fill in.
# deploy/app.env is never committed (.gitignore): it holds secrets.

# Signs the login cookie. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later logs everyone out.
SECRET_KEY=replace-me-with-at-least-32-random-characters

# The address customers type, with https://
SITE_URL=https://capsule.example

# By invitation: only people who know this code can create an account. Keep it set until the
# product data is licensed (PRODUCTION.md, "Before customers"). At least 8 characters; make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(9))"
# The link to hand out is  https://capsule.example/signup?code=<the code>
# (Delete the line to let anybody create an account. The app does not start on the placeholder.)
INVITE_CODE=replace-me-with-a-code-of-your-own

# Outgoing email for password resets. Without it, resets cannot be sent.
#SMTP_URL=smtp://user:password@smtp.example.com:587
#MAIL_FROM=Capsule <no-reply@capsule.example>

# AI pictures of outfits: one of the two switches them on. Every picture is billed to this key.
#OPENAI_API_KEY=
#GEMINI_API_KEY=
